{
  "manifest_version": 3,
  "name": "Print Chamber · 原画立体预览",
  "version": "0.1.1",
  "description": "悬停原画，在本机生成 3D 风格预览。",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://*/*", "http://127.0.0.1:8877/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Print Chamber"},
  "content_scripts": [{
    "matches": ["https://*.artstation.com/*", "https://*.behance.net/*", "https://*.pinterest.com/*", "http://127.0.0.1:8877/*"],
    "js": ["chamber-style.js", "content.js"],
    "run_at": "document_idle"
  }]
}
